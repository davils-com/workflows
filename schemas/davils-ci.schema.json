          "enum": [
            "auto",
            "none",
            "tag",
            "release-please"
          ],
          "default": "auto"
        },
        "tag-patterns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "single": {
              "type": "string",
              "default": "v{version}"
            },
            "package": {
              "type": "string",
              "default": "{package}-v{version}"
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": true
            },
            "on-branch": {
              "type": "string",
              "default": "main"
            }
          }
        },
        "pub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": "auto"
            },
            "environment": {
              "type": "string",
              "default": "pub.dev"
            },
            "wait-for-siblings": {
              "type": "boolean",
              "default": true
            },
            "wait-attempts": {
              "type": "integer",
              "minimum": 0,
              "default": 60
            },
            "wait-interval": {
              "type": "integer",
              "minimum": 0,
              "default": 30
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": true
            },
            "notes-source": {
              "enum": [
                "auto",
                "inspectra",
                "changelog",
                "generate",
                "file",
                "keep"
              ],
              "default": "auto"
            },
            "attest": {
              "type": "boolean",
              "default": true
            },
            "checksums": {
              "type": "boolean",
              "default": true
            },
            "draft": {
              "type": "boolean",
              "default": false
            },
            "make-latest": {
              "$ref": "#/$defs/toggle",
              "default": "auto"
            }
          }
        },
        "release-please": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token-source": {
              "enum": [
                "app",
                "pat",
                "github-token"
              ],
              "default": "app"
            },
            "config-file": {
              "type": "string",
              "default": "release-please-config.json"
            },
            "manifest-file": {
              "type": "string",
              "default": ".release-please-manifest.json"
            },
            "dispatch-workflow": {
              "type": "string",
              "default": ""
            },
            "back-merge": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "description": "Releases: verification, pub.dev, GitHub releases, release-please."
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": true
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "require-scope": {
              "type": "boolean",
              "default": false
            },
            "subject-pattern": {
              "type": "string",
              "default": ""
            }
          }
        },
        "branch-policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": true
            },
            "main-allowed-sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "develop",
                "release-please--*",
                "hotfix/*"
              ]
            }
          }
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      },
      "description": "Checks of pull requests: the title and the source branch."
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harden-runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/$defs/toggle",
              "default": true
            },
            "egress-policy": {
              "enum": [
                "audit",
                "block"
              ],
              "default": "audit"
            },
            "allowed-endpoints": {
              "type": "string",
              "default": ""
            }
          }
        }
      },
      "description": "Hardening of the runners."
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre-setup": {
          "type": "string",
          "default": ""
        },
        "post-setup": {
          "type": "string",
          "default": ""
        },
        "pre-test": {
          "type": "string",
          "default": ""
        },
        "post-test": {
          "type": "string",
          "default": ""
        },
        "pre-publish": {
          "type": "string",
          "default": ""
        }
      },
      "description": "Shell commands run at fixed points of every job."
    },
    "runners": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux": {
          "type": "string",
          "default": "ubuntu-latest"
        },
        "linux-arm": {
          "type": "string",
          "default": "ubuntu-24.04-arm"
        },
        "macos": {
          "type": "string",
          "default": "macos-latest"
        },
        "macos-intel": {
          "type": "string",
          "default": "macos-15-intel"
        },
        "windows": {
          "type": "string",
          "default": "windows-latest"
        },
        "windows-arm": {
          "type": "string",
          "default": "windows-11-arm"
        }
      },
      "description": "Runner labels; a JSON array selects self-hosted runners."
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": {
          "type": "integer",
          "minimum": 0,
          "default": 45
        },
        "inspectra": {
          "type": "integer",
          "minimum": 0,
          "description": "Supply-chain scans and quality gates with Inspectra.",
          "default": 30
        },
        "docs": {
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "build": {
          "type": "integer",
          "minimum": 0,
          "description": "Build artifacts: Flutter apps and native Dart executables.",
          "default": 60
        },
        "publish": {
          "type": "integer",
          "minimum": 0,
          "default": 45
        },
        "release": {
          "type": "integer",
          "minimum": 0,
          "description": "Releases: verification, pub.dev, GitHub releases, release-please.",
          "default": 20
        }
      },
      "description": "Job timeouts in minutes."
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention-days": {
          "type": "integer",
          "minimum": 0,
          "default": 7
        }
      },
      "description": "Artifact settings."
    }
  },
  "$defs": {
    "toggle": {
      "description": "true, false or auto (on when the repository has what the feature needs); on and off work as well.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            "auto",
            "true",
            "false",
            "on",
            "off"
          ]
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "push",
              "tag",
              "pull_request",
              "merge_group",
              "schedule",
              "workflow_dispatch",
              "workflow_call",
              "release",
              "repository_dispatch"
            ]
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
