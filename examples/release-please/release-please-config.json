{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "dart",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "packages": {
    "packages/core": { "component": "my_core" },
    "packages/http": { "component": "my_http" }
  },
  "plugins": [
    { "type": "linked-versions", "groupName": "my", "components": ["my_core", "my_http"] }
  ]
}
